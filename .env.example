# ============================================================
# 七牛云对象存储（图床）配置
# 复制本文件为 .env 后填写真实值：cp .env.example .env
# 获取入口：https://portal.qiniu.com
# ============================================================

# 访问密钥（密钥留在服务端，不会进入前端打包）
QINIU_AK=your-access-key
QINIU_SK=your-secret-key

# 存储桶名称
QINIU_BUCKET=your-bucket-name

# 访问域名（绑定的 CDN 或七牛默认域名），需含协议
# 例如：https://cdn.example.com
QINIU_DOMAIN=https://your-cdn-domain

# 存储区域（与桶所在区域一致）：
#   Zone_z0 华东 | Zone_z1 华北 | Zone_z2 华南
#   Zone_na0 北美 | Zone_as0 东南亚
QINIU_ZONE=Zone_z0

# 是否私有桶：true 时下载 URL 需带签名且会过期
QINIU_PRIVATE=false
# 私有桶签名 URL 有效期（秒），过期后图片链接失效需重新签发
QINIU_URL_TTL=3600

# ============================================================
# 服务监听配置（Node 端读取；不设则用默认值）
# ============================================================
# 监听地址固定为 0.0.0.0（局域网/容器可访问），端口用下面变量覆盖：
PORT=5173          # 开发服务器端口（npm run dev，默认 5173）
PREVIEW_PORT=4173  # 预览服务器端口（vite preview / preview-site，默认 4173）

# ============================================================
# 站点配置（VITE_ 前缀的变量会注入前端，可被 import.meta.env 读取）
# ============================================================
VITE_SITE_TITLE=PTDoc · 我的 Markdown 文档站
VITE_DEFAULT_DOC=/docs/index.md
