# ============================================================
# 服务端密钥（必需）。用于加密用户对象存储 SecretKey
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
PTDOC_DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PTDOC_SESSION_TTL_DAYS=7

# ============================================================
# 服务监听配置（Node 端读取；不设则用默认值）
# ============================================================
PORT=5173
PREVIEW_PORT=4173

# ============================================================
# 站点配置（VITE_ 前缀的变量会注入前端）
# ============================================================
VITE_SITE_TITLE=PTDoc · 我的 Markdown 文档站
VITE_DEFAULT_DOC=/docs/index.md

# ============================================================
# 对象存储已改为登录后「设置」页按用户填写，不再使用下列变量。
# 以下仅作字段对照，系统启动时不会读取：
# QINIU_AK / QINIU_SK / QINIU_BUCKET / QINIU_DOMAIN / QINIU_ZONE
# QINIU_PRIVATE / QINIU_URL_TTL
# ============================================================

# ============================================================
# 可选：VoltOps 远端可观测。空则仅本地 Trace。
# ============================================================
VOLTAGENT_PUBLIC_KEY=
VOLTAGENT_SECRET_KEY=
