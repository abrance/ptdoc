{
  "name": "ptdoc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人 Markdown 文档工具：整合 Mermaid 渲染与七牛云图床，用于编写与展示 md 文档。",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build-site": "node --experimental-strip-types scripts/build-site.ts",
    "preview-site": "vite preview --outDir dist-site --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 src/server/*.test.ts"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "marked": "^18.0.0",
    "minisearch": "^7.2.0",
    "qiniu": "^7.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
