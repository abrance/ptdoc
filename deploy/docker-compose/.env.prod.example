# PTDoc 生产部署配置模板（docker-compose.prod.yml 使用）
# 用法：cp .env.prod.example .env 后填写
# ============================================================

# 必需：64 位 hex（32 字节）数据加密密钥，用于加密用户七牛 SecretKey
# 生成：openssl rand -hex 32
PTDOC_DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PTDOC_SESSION_TTL_DAYS=7

# ── 端口 ────────────────────────────────────────────────────
# 容器内 preview 监听端口（与镜像默认一致，一般不用改）
PREVIEW_PORT=4173
# 宿主机对外映射端口（http://<服务器IP>:PTDOC_PORT）
PTDOC_PORT=4173

# ── 镜像 tag（可选）─────────────────────────────────────────
# 默认 v1.0.3；升级时改成新 tag 后执行 docker compose pull
PTDOC_TAG=v1.0.3
