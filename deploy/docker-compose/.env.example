# ============================================================
# PTDoc 服务器部署配置
# 复制为 .env 后填写：cp .env.example .env
# 若项目根目录已有 .env，可直接复制过来：cp ../../.env .env
# ============================================================

# ── 七牛云对象存储（图床）────────────────────────────────────
# 密钥只留在服务器容器内，不会进入前端打包
QINIU_AK=your-access-key
QINIU_SK=your-secret-key
QINIU_BUCKET=your-bucket-name
QINIU_DOMAIN=https://your-cdn-domain
QINIU_ZONE=Zone_z0
QINIU_PRIVATE=false
QINIU_URL_TTL=3600

# ── 端口 ─────────────────────────────────────────────────────
# 容器内 preview 服务器监听端口（一般不用改；与 Dockerfile CMD 一致）
PREVIEW_PORT=4173
# 宿主机对外映射端口（浏览器访问 http://服务器IP:PTDOC_PORT）
PTDOC_PORT=4173

# ── 站点配置（构建时注入前端，改了需重新 make up 重建镜像）───
VITE_SITE_TITLE=PTDoc · 我的 Markdown 文档站
VITE_DEFAULT_DOC=/docs/index.md
