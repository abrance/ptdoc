# ============================================================
# PTDoc 服务器部署配置
# 复制为 .env 后填写：cp .env.example .env
# ============================================================

# 必需：32 字节 hex，用于加密用户七牛 SecretKey
PTDOC_DATA_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PTDOC_SESSION_TTL_DAYS=7

# ── 端口 ─────────────────────────────────────────────────────
PREVIEW_PORT=4173
PTDOC_PORT=4173

# ── 站点配置（构建时注入前端，改了需重新 make up 重建镜像）───
VITE_SITE_TITLE=PTDoc · 我的 Markdown 文档站
VITE_DEFAULT_DOC=/docs/index.md
